{
  "name": "arenales-pegball",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/core.test.js tests/physics.test.js",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-arenales-pegball 'node --test tests/firebase.test.js'",
    "test:browser": "playwright test",
    "simulate": "node scripts/solve-level.js",
    "deploy": "npm run build && node scripts/firebase-cli.js deploy --only hosting,firestore:rules --project arenales-pegball",
    "firebase:login": "node scripts/firebase-cli.js login --interactive",
    "firebase:logout": "node scripts/firebase-cli.js logout",
    "test:production": "node scripts/verify-production.js"
  },
  "dependencies": {
    "firebase": "^12.5.0",
    "phaser": "^3.90.0",
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "vite": "^7.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
